{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "EarnFi Documentation",
  "colors": {
    "primary": "#046be9",
    "light": "#0683c9",
    "dark": "#144980"
  },
  "favicon": "/favicon.png",
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "getting-started/connect-wallet",
              "getting-started/profile",
              "getting-started/wallet-treasury"
            ]
          },
          {
            "group": "Earn",
            "pages": [
              "earn/jobs-feed",
              "earn/job-board",
              "earn/job-types",
              "earn/submit-work",
              "earn/pending",
              "earn/earnings",
              "earn/your-journey",
              "earn/share-earnings-card",
              "earn/withdrawals",
              "earn/referrals",
              "earn/token-gated-jobs"
            ]
          },
          {
            "group": "Hire & pay",
            "pages": [
              "earn/marketplace",
              "earn/deals",
              "earn/reviews"
            ]
          }
        ]
      },
      {
        "tab": "Creators",
        "groups": [
          {
            "group": "Creator hub",
            "pages": [
              "creators/overview",
              "creators/creating-jobs",
              "creators/job-board",
              "creators/token-gated-jobs",
              "creators/jobs",
              "creators/disputes",
              "creators/verifications",
              "creators/payments"
            ]
          }
        ]
      },
      {
        "tab": "Integrations",
        "groups": [
          {
            "group": "APIs",
            "pages": [
              "integrations/work-api",
              "integrations/agent-api",
              "integrations/human-actions",
              "integrations/openapi-x402",
              "integrations/mcp-server"
            ]
          }
        ]
      },
      {
        "tab": "Tools",
        "groups": [
          {
            "group": "Utilities",
            "pages": [
              "tools/recover-sol",
              "tools/burn-vault",
              "tools/contests"
            ]
          }
        ]
      },
      {
        "tab": "Safety",
        "groups": [
          {
            "group": "Account & verification",
            "pages": [
              "safety/x-verification",
              "safety/restrictions",
              "safety/safety-notices"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/logo-light.png",
    "dark": "/logo/logo-dark.png",
    "href": "https://earnfi.fun"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@earnfi.fun"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open EarnFi",
      "href": "https://app.earnfi.fun"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/earnfidotfun",
      "github": "https://github.com/earnfidotfun",
      "telegram": "https://t.me/earnfidotfun1"
    }
  },
  "background": {
    "color": {
      "dark": "#030610",
      "light": "#f7f7f7"
    }
  },
  "appearance": {
    "default": "system"
  },
  "interaction": {
    "drilldown": true
  },
  "seo": {
    "indexing": "navigable"
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "search": {
    "prompt": "Search or Ask AI"
  },
  "styling": {
    "latex": true
  },
  "fonts": {
    "family": "Inter",
    "weight": 400,
    "format": "woff"
  }
}
